extends SceneTree
## Builds the website's images and playable demo puzzles into docs/:
##   godot --headless --path . --script res://tools/make_site_assets.gd

const LevelGen := preload("res://scripts/level_gen.gd")

func _save_scaled(src: String, dst: String, w: int, h: int) -> void:
	var img := Image.load_from_file(src)
	img.convert(Image.FORMAT_RGBA8)
	img.resize(w, h, Image.INTERPOLATE_LANCZOS)
	img.save_png(dst)

func _init() -> void:
	var shots := ["01_hardest_arrow_game", "02_tap_to_slide_out", "03_1000_levels", "04_blocked", "05_black_and_white", "06_level_clear"]
	for i in shots.size():
		_save_scaled("res://store/screenshots/%s.png" % shots[i], "res://docs/assets/img/shot%d.png" % (i + 1), 540, 960)
	_save_scaled("res://store/icon_512.png", "res://docs/assets/img/icon-512.png", 512, 512)
	_save_scaled("res://store/icon_512.png", "res://docs/assets/img/favicon.png", 64, 64)
	_save_scaled("res://store/icon_512.png", "res://docs/assets/img/apple-touch-icon.png", 180, 180)
	_save_scaled("res://store/feature_graphic_1024x500.png", "res://docs/assets/img/og.png", 1024, 500)

	# Small playable puzzles for the "try it" demo (same generator as the real game).
	var params := {"w": 6, "h": 6, "shape": "rect", "min_len": 2, "max_len": 6, "straight": 0.55, "bias": 0.7, "k": 4, "fill": 0.85}
	var out: Array = []
	var n := 0
	while out.size() < 8 and n < 4000:
		n += 1
		var level := LevelGen.generate(params, "web-demo-%d" % n)
		var st := LevelGen.analyze(level)
		if st.solvable and st.arrows >= 9 and st.arrows <= 13 and st.depth >= 4 and st.free0 >= 2 and st.free0 <= 4:
			out.append({"w": 6, "h": 6, "a": LevelGen.encode(level)})
	var f := FileAccess.open("res://docs/assets/js/puzzles.js", FileAccess.WRITE)
	f.store_string("// Generated by tools/make_site_assets.gd with the game's own level generator.\nwindow.ARROW_PUZZLES = " + JSON.stringify(out) + ";\n")
	f.close()
	print("assets done; puzzles: %d (tried %d seeds)" % [out.size(), n])
	quit(0)
